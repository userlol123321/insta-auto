<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="InstaAuto DM"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#33DA3633"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="STOPPED"
                android:textColor="#F85149"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Start/Stop Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleBot"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2EA043"
            android:text="▶ Start Automator 24/7"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <!-- Stats Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#161B22"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DMs Sent"
                    android:textColor="#8B949E"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvStatDMs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#58A6FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#161B22"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Followers"
                    android:textColor="#8B949E"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvStatFollowers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#3FB950"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#161B22"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blocked"
                    android:textColor="#8B949E"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvStatBlocked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F85149"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Instagram Account Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔐 Instagram Account / API Key"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#0D1117"
                    android:hint="Instagram Username"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#0D1117"
                    android:hint="Instagram Password (or API Key / Access Token)"
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etTwoFactorCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#0D1117"
                    android:hint="2FA / OTP Verification Code (if prompted)"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Campaign & Follower Link Gate Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Trigger Keywords &amp; Follower Link"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Trigger Keywords (comma separated)"
                    android:textColor="#8B949E"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etKeywords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0D1117"
                    android:hint="link, send, guide, free"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="DM Link Template (Sent ONLY to Followers)"
                    android:textColor="#8B949E"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etFollowerDM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0D1117"
                    android:hint="Hey @{username}! Here is your link: https://yourwebsite.com/resource"
                    android:lines="3"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Comment Reply to Non-Followers (Blocks Link &amp; Asks to Follow)"
                    android:textColor="#8B949E"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etNonFollowerReply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0D1117"
                    android:hint="Hey @{username}! Please follow @{my_username} and comment again to get the link! 🙌"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Target Post / Reel URL (Optional)"
                    android:textColor="#8B949E"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etTargetPost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0D1117"
                    android:hint="https://www.instagram.com/reel/C.../ (leave blank for latest posts)"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#58A6FF"
                    android:text="💾 Save Settings (No Code Changes)"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Activity Log -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="12dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📜 Live Activity Logs"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="8dp"
                    android:background="#090D13"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:text="[Ready] Configure your settings above and tap Start Automator."
                    android:textColor="#8B949E"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
